{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
      "type": "small",
      "padding": {
          "top": 1,
          "right": 2,
          "left": 3
      }
  },
  "display": {
      "separator": ">  ",
      "color": {
          "separator": "white",
          "keys": "green"
      }
  },

  
  "modules": [
      {
          "format": "╔════ 󰓎  System Information 󰓎  ════╗ ",
          "type": "title"
      },
            {
          "key": "  {#1} distro   ",
          "format": "{name}",
          "type": "os"
      },
      {
          "key": "  {#1} kernel   ",
          "format": "{release}",
          "type": "kernel"
      },
      {
          "key": "  {#1}󰅐 uptime   ",
          "type": "uptime"
      },
      {
        "key": "  {#1} packages ",
        "type": "packages",
        "format": "{2} (pacman)"
      },
      {
          "key": "  {#1}󰇄 desktop  ",
          "type": "de"
      },
      {
          "key": "  {#1} term     ",
          "type": "terminal"
      },
      {
          "key": "  {#1} shell    ",
          "type": "shell"
      },
      {
          "key": "  {#1} colors   ",
          "type": "colors",
          "symbol": "circle"
      },
      {
          "format": "╚══════════════════════════════════╝",
          "type": "custom"
      }
  ]
}
